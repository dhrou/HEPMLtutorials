      "source": [
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "def compare_train_test(\n",
        "    y_pred_train,\n",
        "    y_train,\n",
        "    y_pred_test,\n",
        "    y_test,\n",
        "    *,\n",
        "    bins=30,\n",
        "    value_range=(0, 1),\n",
        "    xlabel=\"\",\n",
        "    ylabel=\"Arbitrary units\",\n",
        "    title=\"\",\n",
        "    weights_train=None,\n",
        "    weights_test=None,\n",
        "    density=True,\n",
        "):\n",
        "    def split_by_class(y_pred, y_true, weights):\n",
        "        mask_s = y_true == 1\n",
        "        mask_b = ~mask_s\n",
        "\n",
        "        w_s = weights[mask_s] if weights is not None else None\n",
        "        w_b = weights[mask_b] if weights is not None else None\n",
        "\n",
        "        return (y_pred[mask_s], w_s), (y_pred[mask_b], w_b)\n",
        "\n",
        "    def plot_hist(data, weights, color, label):\n",
        "        plt.hist(\n",
        "            data,\n",
        "            bins=bins,\n",
        "            range=value_range,\n",
        "            density=density,\n",
        "            weights=weights,\n",
        "            histtype=\"stepfilled\",\n",
        "            alpha=0.5,\n",
        "            color=color,\n",
        "            label=label,\n",
        "        )\n",
        "\n",
        "    def plot_errorbar(data, weights, color, label):\n",
        "        hist, bin_edges = np.histogram(\n",
        "            data,\n",
        "            bins=bins,\n",
        "            range=value_range,\n",
        "            density=density,\n",
        "            weights=weights,\n",
        "        )\n",
        "\n",
        "        # Poisson uncertainty handling\n",
        "        scale = len(data) / hist.sum() if hist.sum() > 0 else 1\n",
        "        err = np.sqrt(hist * scale) / scale\n",
        "\n",
        "        centers = (bin_edges[:-1] + bin_edges[1:]) / 2\n",
        "\n",
        "        plt.errorbar(centers, hist, yerr=err, fmt=\"o\", color=color, label=label)\n",
        "\n",
        "    # --- Split data\n",
        "    (train_s, w_train_s), (train_b, w_train_b) = split_by_class(\n",
        "        y_pred_train, y_train, weights_train\n",
        "    )\n",
        "    (test_s, w_test_s), (test_b, w_test_b) = split_by_class(\n",
        "        y_pred_test, y_test, weights_test\n",
        "    )\n",
        "\n",
        "    # --- Plot train\n",
        "    plot_hist(train_s, w_train_s, \"r\", \"S (train)\")\n",
        "    plot_hist(train_b, w_train_b, \"b\", \"B (train)\")\n",
        "\n",
        "    # --- Plot test\n",
        "    plot_errorbar(test_s, w_test_s, \"r\", \"S (test)\")\n",
        "    plot_errorbar(test_b, w_test_b, \"b\", \"B (test)\")\n",
        "\n",
        "    # --- Cosmetics\n",
        "    plt.title(title)\n",
        "    plt.xlabel(xlabel)\n",
        "    plt.ylabel(ylabel)\n",
        "    plt.legend()\n"
      ]
